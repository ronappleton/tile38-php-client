{
    "name": "ronappleton/tile38-php-client",
    "description": "A php client for the Tile38 Ultra Fast Geospatial Database",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ronappleton\\Tile38PhpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ronappleton\\Tile38PhpClient\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ron Appleton",
            "email": "ron.appleton@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "ext-redis": "*",
        "ronappleton/php-geojson": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.8",
        "webimpress/coding-standard": "^1.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=ruleset.xml src tests",
        "cs:fix": "phpcbf --standard=ruleset.xml src tests"
    }
}

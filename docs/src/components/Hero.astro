    <h1 set:html={title} />
    <p class="map-hero-sub">{tagline}</p>
    <div class="map-hero-actions">
      {actions.map((action) => (
        <a
          class={action.variant === 'primary' ? 'primary' : 'secondary'}
          href={action.link}
          target={action.link.startsWith('http') ? '_blank' : undefined}
          rel={action.link.startsWith('http') ? 'noreferrer' : undefined}
        >
          {action.text}
        </a>
      ))}
    </div>
  </div>

  <div class="map-hero-code">
